# Copy this file to `.env` and fill in your key.
# Get an API key at https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-opus-4-8).
# Cheaper alternatives: claude-sonnet-4-6, claude-haiku-4-5
# AGENTS_MODEL=claude-sonnet-4-6

# Optional: where agent memory is stored (default: ~/.personal_agents).
# Point it at the repo to keep your data alongside the code:
# AGENTS_DATA_DIR=./data
