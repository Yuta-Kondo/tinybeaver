# Copy this file to `.env` and fill in your key.

ANTHROPIC_API_KEY=sk-ant-...

# Tavily web search (tavily.com — free for students)
TAVILY_API_KEY=

# Gmail API (Google Cloud Console → APIs & Services → Credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Z.ai API (Zhipu AI - for GLM 5.2 model, via LiteLLM's zai/ provider)
ZAI_API_KEY=

# Google Gemini API
GOOGLE_API_KEY=

# Contact email — used in outbound request headers and web-push VAPID claims
CONTACT_EMAIL=you@example.com

# Jina Reader API (optional — improves URL fetching in chat; r.jina.ai)
JINA_API_KEY=

# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Scheduler timezone (IANA name, e.g. America/Toronto)
SCHEDULER_TZ=America/Toronto