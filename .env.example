# Copy this file to `.env` and fill in your key(s).

# --- Anthropic (default backend) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Gemini (optional) ---
# Get a key at https://aistudio.google.com/
# GOOGLE_API_KEY=...

# --- DeepSeek (optional, very cheap) ---
# Get a key at https://platform.deepseek.com/
# DEEPSEEK_API_KEY=...

# Optional: override the model (default: claude-opus-4-8).
# Anthropic:   claude-haiku-4-5  |  claude-sonnet-4-6  |  claude-opus-4-8
# Google:      gemini-2.5-flash-lite  |  gemini-3.5-flash
# DeepSeek:    deepseek-v4-flash  |  deepseek-v4-pro
# AGENTS_MODEL=deepseek-v4-flash

# Optional: where agent memory is stored (default: ~/.personal_agents).
# AGENTS_DATA_DIR=./data
